#include <windows.h>
#include <iostream>
#include <fstream>
#include <string>

using namespace std;

int main()
{
    // COM 포트 열기
    HANDLE hSerial = CreateFileA(
        "\\\\.\\COM6",
        GENERIC_READ,
        0,
        NULL,
        OPEN_EXISTING,
        0,
        NULL
    );

    if (hSerial == INVALID_HANDLE_VALUE)
    {
        cout << "COM6 포트를 열 수 없습니다." << endl;
        return 1;
    }

    // 시리얼 통신 설정
    DCB dcbSerialParams = { 0 };
    dcbSerialParams.DCBlength = sizeof(dcbSerialParams);

    GetCommState(hSerial, &dcbSerialParams);

    dcbSerialParams.BaudRate = CBR_9600;
    dcbSerialParams.ByteSize = 8;
    dcbSerialParams.StopBits = ONESTOPBIT;
    dcbSerialParams.Parity = NOPARITY;

    SetCommState(hSerial, &dcbSerialParams);

    // 타임아웃 설정
    COMMTIMEOUTS timeouts = { 0 };

    timeouts.ReadIntervalTimeout = 50;
    timeouts.ReadTotalTimeoutConstant = 50;
    timeouts.ReadTotalTimeoutMultiplier = 10;

    SetCommTimeouts(hSerial, &timeouts);

    // CSV 파일 생성
    ofstream file("distance.csv");

    file << "Time_ms,Distance_cm" << endl;

    char buffer[256];
    DWORD bytesRead;

    string line = "";

    cout << "Arduino 데이터 수신 시작..." << endl;

    while (true)
    {
        if (ReadFile(
            hSerial,
            buffer,
            sizeof(buffer) - 1,
            &bytesRead,
            NULL))
        {
            if (bytesRead > 0)
            {
                buffer[bytesRead] = '\0';

                for (DWORD i = 0; i < bytesRead; i++)
                {
                    char c = buffer[i];

                    if (c == '\n')
                    {
                        cout << line << endl;

                        file << line << endl;
                        file.flush();

                        line.clear();
                    }
                    else if (c != '\r')
                    {
                        line += c;
                    }
                }
            }
        }
    }

    file.close();
    CloseHandle(hSerial);

    return 0;
}
